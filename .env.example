# Chat：任意 OpenAI 兼容服务（Ollama / vLLM / DeepSeek / DashScope / OpenAI ...）
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://10.67.34.44:11434/v1
OPENAI_MODEL=qwen3.8:27b
# 云端示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=qwen-plus
# 是否给模型发摄像头画面：auto=问 Ollama /api/show（非 Ollama 先发，400 后停发），true / false=直接指定
LLM_VISION=auto
# 附加到每次 chat 请求体的 JSON，例如 {"enable_thinking": false}
LLM_EXTRA_BODY=
LLM_TIMEOUT_S=600

# ASR：local=本机 faster-whisper，ollama=Ollama /api/chat（旧值 remote 等同 ollama），openai=OpenAI 兼容 API
ASR_BACKEND=local
# 识别语言，留空=自动检测（local / openai transcriptions 生效）
ASR_LANGUAGE=zh
ASR_TIMEOUT_S=300

# local：模型名（tiny/base/small/medium/large-v3/large-v3-turbo）或本地 CTranslate2 目录
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ollama
OLLAMA_ASR_MODEL=frozenlab/qwen3-asr:0.6b
# 留空则从 OPENAI_BASE_URL 去掉 /v1 作为 Ollama 根地址
OLLAMA_BASE_URL=

# openai：ASR_BASE_URL / ASR_API_KEY 留空则沿用 OPENAI_BASE_URL / OPENAI_API_KEY
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# transcriptions=POST /audio/transcriptions（OpenAI Whisper、SiliconFlow SenseVoice、vLLM、speaches 等）
# chat=POST /chat/completions，音频作为 input_audio data URL（如 DashScope qwen3-asr-flash）
ASR_API_MODE=transcriptions
# 附加请求体 JSON，例如 qwen3-asr-flash：{"asr_options": {"language": "zh"}}
ASR_EXTRA_BODY=

TTS_BACKEND=local
TTS_ENABLED=true
TTS_VOICE=Microsoft Huihui Desktop
TTS_RATE=180

HTTP_PROXY=http://10.158.100.9:8080
HTTPS_PROXY=http://10.158.100.9:8080
http_proxy=http://10.158.100.9:8080
https_proxy=http://10.158.100.9:8080

# 内网模型服务直连；云端服务走上面的代理。新增内网 chat / ASR 主机时把 IP 追加进来（逗号分隔）
NO_PROXY=10.67.34.44
no_proxy=10.67.34.44

ARDUINO_FQBN=arduino:avr:uno
ARDUINO_CLI=arduino-cli
CAMERA_INDEX=0
YOLO_MODEL_PATH=models/best.pt
# gpu=Intel 核显（默认），npu=Intel NPU，cpu=PyTorch，auto=优先 NPU
YOLO_DEVICE=gpu
DATABASE_PATH=data/copilot.db

# 维修模式
# iFixit 公开 API（只读、无需 Key），经上面的 HTTPS_PROXY 出网
IFIXIT_ENABLED=true
IFIXIT_BASE_URL=https://www.ifixit.com/api/2.0
IFIXIT_TIMEOUT_S=15
# 上传的原理图、维修手册存放目录
REPAIR_DOCS_DIR=data/repair_docs
# 维修模式附图长边（PCB 丝印小，比教学模式的 768 大）
REPAIR_FRAME_MAX_SIDE=1280
# 视觉模型输出框的坐标约定：norm1000=0-1000 相对坐标（Qwen-VL 等），norm1=0-1，pixel=所发图片像素
REPAIR_BOX_FORMAT=norm1000
